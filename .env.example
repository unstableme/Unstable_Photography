# Template for local development.
#
#   cp .env.example .env      then fill in the real values
#
# .env is gitignored. THIS file is committed, so it must never contain a real
# key, password or connection string.
#
# On Render these are set as environment variables in the dashboard instead,
# and no .env file exists there.

# Cloudinary - Dashboard > API Keys > "API environment variable".
# The cloud name (after the @) is public and appears in every image URL your
# site serves; the key and secret before it are the parts that must stay secret.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Neon Postgres - Neon Console > your project > Connection string.
# Use sqlite:///db.sqlite3 instead if you just want to run the site offline.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Any long random string for local use. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=<random-50-char-string>

# Turn on Django's debug pages for LOCAL work only. Leave this unset on Render:
# with no value, DEBUG defaults to False, which is what production must run.
DEBUG=True
