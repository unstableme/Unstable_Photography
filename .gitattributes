# Git LFS only for the local media archive, which the running site never reads
# (Cloudinary serves uploaded photos). Everything under static/ must be a plain
# git blob: Vercel does not fetch LFS objects, so pointers would be served as
# 131-byte "images".
media/**/*.jpg filter=lfs diff=lfs merge=lfs -text
media/**/*.png filter=lfs diff=lfs merge=lfs -text
media/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
